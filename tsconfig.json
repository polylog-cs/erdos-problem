{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@motion-canvas/2d/lib",
    "types": ["@motion-canvas/core/project"]
  },
  "include": [
    "src/project.ts",
    "src/exportFrames.ts",
    "src/project-query.d.ts",
    "src/lib/**/*",
    "src/scenes/unitDistanceRulerIntro.tsx",
    "src/scenes/cherryCountingTwoWays.tsx",
    "src/scenes/gridPythagoreanDistances.tsx",
    "src/scenes/primeProductSweep.tsx",
    "src/scenes/discreteGeometryAntIsland.tsx",
    "src/scenes/cyclotomicPointsetSpiral.tsx",
    "src/scenes/asymptoticUnitDistanceTimeline.tsx"
  ]
}
